 def recipes():
     return json.loads((CFG_DIR/'recipes.json').read_text(encoding='utf8'))
+
+
+# Historical evidence levels are intentionally distinct from run eligibility.
+# Only reconstructed notebook commands are allowed for strict legacy runs.
+# The controlled revision may execute explicitly documented reconstructions,
+# which remain labelled as inferences in every run manifest and report.
+def recipe_authorized(provenance: str, protocol_mode: str, allow_unverified: bool=False) -> bool:
+    if allow_unverified:
+        return True
+    if provenance == 'reconstructed':
+        return True
+    return (protocol_mode == 'controlled_revision_v2'
+            and provenance in {'source_documented', 'documented_inference'})
 
 
