+"""Source-derived command reconstruction: never conflate historical proof and usability."""
+from collections import Counter
+from ragtree.experiments.kbs.protocol import recipes, job_matrix, recipe_authorized
+
+
+def test_provenance_counts_and_matrix():
+    entries=recipes()
+    assert len(entries)==60
+    assert Counter(r['provenance'] for r in entries)=={
+        'reconstructed':50,'source_documented':5,'documented_inference':5}
+    assert len(job_matrix())==192
+    assert sum(recipe_authorized(r['provenance'],'legacy_xquality') for r in entries)==50
+    assert sum(recipe_authorized(r['provenance'],'controlled_revision_v2') for r in entries)==60
+
+
+def test_inference_never_passes_strict_legacy_check():
+    for status in ('source_documented','documented_inference','unverified','unverified_mapping','inferred'):
+        assert not recipe_authorized(status,'legacy_xquality')
+    for status in ('unverified','unverified_mapping','inferred','unknown'):
+        assert not recipe_authorized(status,'controlled_revision_v2')
+    assert recipe_authorized('documented_inference','legacy_xquality',True)
+
+
+def test_arag_mapping_documented_and_commands_preserved():
+    rows=[r for r in recipes() if r['method']=='agentic_hybrid']
+    assert len(rows)==5
+    for r in rows:
+        assert r['provenance']=='source_documented'
+        assert '--max-llm-calls' in r['args']
+        assert r['args'][r['args'].index('--max-llm-calls')+1]=='1'
+        assert 'run_agentic_runtime_co2_n_docs.py' in r['source']
+
+
+def test_marag_supplementary_shot_types_are_not_mislabeled_historical():
+    expected={'maven_ere':'train','eventstoryline':'full',
+              'fincausal':'train.csv','causalbank':'resulted_from'}
+    rows=[r for r in recipes() if r['method']=='marag' and r['dataset'] in expected]
+    assert len(rows)==4
+    for r in rows:
+        assert r['provenance']=='documented_inference'
+        assert r['args'][r['args'].index('--shot-type')+1]==expected[r['dataset']]
+        assert 'run_missing_marag_runtime_co2.py' in r['source']
+
+
+def test_eventstoryline_baseline_evaluation_is_not_generation_proof():
+    r=next(r for r in recipes() if r['method']=='baseline' and r['dataset']=='eventstoryline')
+    assert r['provenance']=='documented_inference'
+    assert r['args'][r['args'].index('--doc-type')+1]=='all'
+    assert 'evaluation only' in r['source']
